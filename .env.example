# Get this free at aistudio.google.com
GEMINI_API_KEY=

# Your phone number in international format e.g. +15551234567
SIGNAL_PHONE_NUMBER=

# The phone number or Signal group to send messages to
SIGNAL_RECIPIENT=

# Any unique string you choose e.g. mynexus2024
NTFY_TOPIC=

# Leave as default unless self-hosting ntfy
NTFY_URL=https://ntfy.sh

# Your school's Canvas URL e.g. yourschool.instructure.com
CANVAS_BASE_URL=

# Generate in Canvas Settings > New Access Token
CANVAS_API_TOKEN=

# Your PowerSchool login URL
POWERSCHOOL_URL=

# Your PowerSchool username
POWERSCHOOL_USERNAME=

# Your PowerSchool password
POWERSCHOOL_PASSWORD=

# railway, render, local, or oracle
DEPLOYMENT_ENV=railway
